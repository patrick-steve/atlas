{
  "name": "atlas-circuits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZK circuits and prove/verify helpers for the Atlas distributed proving pipeline",
  "scripts": {
    "compile:multiplier": "circom multiplier.circom --r1cs --wasm --sym -o build",
    "compile:balance": "circom balance_proof.circom --r1cs --wasm --sym -o build -l node_modules",
    "setup:multiplier": "node scripts/setup.js multiplier",
    "setup:balance": "node scripts/setup.js balance_proof",
    "prove": "node prove.js",
    "verify": "node verify.js"
  },
  "dependencies": {
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.4"
  }
}
