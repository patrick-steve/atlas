# Multiplier warm-up artefacts (toolchain check only; never referenced again)
pipeline/circuits/build/multiplier_input.json
pipeline/circuits/build/multiplier_proof.json
pipeline/circuits/build/multiplier_public.json

# Observer + benchmark raw output (regenerated per run)
pipeline/observer/observer-log.jsonl
pipeline/benchmark/runs/sweep.jsonl

# Keep baseline.json — it's the measured single-worker distribution that
# seeds synthesize.js, and it's tiny.
!pipeline/benchmark/runs/baseline.json

